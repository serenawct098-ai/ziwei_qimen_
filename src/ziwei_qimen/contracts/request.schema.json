{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://serenawct098-ai.github.io/ziwei_qimen/contracts/request.schema.json",
  "title": "Zi Wei x Qi Men Request",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "ziwei": {
      "$ref": "#/$defs/ziweiRequest"
    },
    "qimen": {
      "$ref": "#/$defs/qimenRequest"
    }
  },
  "anyOf": [
    {
      "required": ["ziwei"]
    },
    {
      "required": ["qimen"]
    }
  ],
  "$defs": {
    "civilDateTime": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}$"
    },
    "countryCode": {
      "type": "string",
      "pattern": "^[A-Z]{2}$"
    },
    "cityLocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["city"],
      "properties": {
        "city": {
          "type": "string",
          "minLength": 1
        },
        "country_code": {
          "$ref": "#/$defs/countryCode"
        }
      }
    },
    "ziweiRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "birth_civil_datetime",
        "birth_location",
        "gender",
        "analysis_civil_datetime",
        "analysis_timezone"
      ],
      "properties": {
        "birth_civil_datetime": {
          "$ref": "#/$defs/civilDateTime"
        },
        "birth_location": {
          "$ref": "#/$defs/cityLocation"
        },
        "gender": {
          "type": "string",
          "enum": ["female", "male"]
        },
        "analysis_civil_datetime": {
          "$ref": "#/$defs/civilDateTime"
        },
        "analysis_timezone": {
          "type": "string",
          "pattern": "^[A-Za-z_+-]+/[A-Za-z_+\\-]+(?:/[A-Za-z_+\\-]+)*$"
        }
      }
    },
    "qimenRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question_civil_datetime",
        "question_location",
        "question_category"
      ],
      "properties": {
        "question_civil_datetime": {
          "$ref": "#/$defs/civilDateTime"
        },
        "question_location": {
          "$ref": "#/$defs/cityLocation"
        },
        "primary_residence_location": {
          "$ref": "#/$defs/cityLocation"
        },
        "question_category": {
          "type": "string",
          "enum": [
            "career",
            "wealth",
            "relationship",
            "health",
            "travel",
            "event_development"
          ]
        }
      }
    }
  }
}
